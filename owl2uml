#!/usr/bin/env bash
# Wrapper: runs the owl2uml CLI using the project virtualenv if present.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="python3"
if [ -x "$here/.venv/bin/python" ]; then
  py="$here/.venv/bin/python"
fi
exec "$py" -c "import sys; sys.path.insert(0, '$here/src'); from owl2uml.cli import main; sys.exit(main())" "$@"
