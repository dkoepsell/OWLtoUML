@prefix :     <http://example.org/p2p/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Closed-world checks of the 'preceded by some' axioms on the logged cases.
# OWL alone would assume the missing predecessor exists somewhere; SHACL
# reports that it is not in the log.
:prefixes sh:declare [ sh:prefix "p2p" ; sh:namespace "http://example.org/p2p/"^^xsd:anyURI ] ,
                     [ sh:prefix "obo" ; sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ] .

:N1 a sh:NodeShape ; sh:targetClass :PaymentRelease ; rdfs:label "N1 no payment before three-way match" ;
  sh:sparql [ sh:prefixes :prefixes ; sh:message "Payment released before the three-way match" ;
    sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this obo:RO_0002087+ ?m . ?m a p2p:ThreeWayMatch } }""" ] .
:N3 a sh:NodeShape ; sh:targetClass :POIssue ; rdfs:label "N3 director approval above threshold" ;
  sh:sparql [ sh:prefixes :prefixes ; sh:message "PO above $10,000 with no director approval before it" ;
    sh:select """SELECT $this WHERE { $this p2p:forAmount ?a . FILTER (?a > 10000)
      FILTER NOT EXISTS { $this obo:RO_0002087+ ?d . ?d a p2p:DirectorApproval } }""" ] .
:N4 a sh:NodeShape ; sh:targetClass :POIssue ; rdfs:label "N4 three quotes above threshold" ;
  sh:sparql [ sh:prefixes :prefixes ; sh:message "PO above $25,000 with no quotation set before it" ;
    sh:select """SELECT $this WHERE { $this p2p:forAmount ?a . FILTER (?a > 25000)
      FILTER NOT EXISTS { $this obo:RO_0002087+ ?q . ?q a p2p:QuoteCollection } }""" ] .
:N7 a sh:NodeShape ; sh:targetClass :InvoiceReceipt ; rdfs:label "N7 purchase order before invoice" ;
  sh:sparql [ sh:prefixes :prefixes ; sh:message "Invoice received with no purchase order before it" ;
    sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this obo:RO_0002087+ ?p . ?p a p2p:POIssue } }""" ] .
