@prefix : <http://example.org/main#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/main> a owl:Ontology ;
    owl:imports <http://example.net/mid.owl> .

:Dog a owl:Class ; rdfs:subClassOf <http://example.net/mid#Animal> .
