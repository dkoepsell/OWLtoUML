@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix lof: <https://w3id.org/lof/> .
@prefix nao: <https://sool.davidkoepsell.com/nao/NAO_> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

nao:0001000 a owl:Class ;
    rdfs:label "accountable agent"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001001 ] ) ] ;
    skos:definition "A material entity that is the bearer of some accountability capacity."@en .

nao:0001010 a owl:Class ;
    rdfs:label "repeat breach"@en ;
    rdfs:subClassOf nao:0001009 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( nao:0001009 [ a owl:Restriction ;
                        owl:onProperty nao:0001107 ;
                        owl:someValuesFrom nao:0001009 ] ) ] ;
    skos:definition "A normative breach that is a repetition of an earlier breach attributed to the same agent."@en .

nao:0001012 a owl:Class ;
    rdfs:label "apology"@en ;
    rdfs:comment "A string of apologetic words generated on request is not an apology in this sense unless it realizes the producer's answerability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001008 ],
        nao:0001011 ;
    skos:definition "An accountability response in which an agent acknowledges a breach as its own and that the breach wronged someone."@en .

nao:0001013 a owl:Class ;
    rdfs:label "restitution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001008 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001002 ],
        nao:0001011 ;
    skos:definition "An accountability response in which an agent makes good, from its own resources or conduct, a setback that a breach caused."@en .

nao:0001014 a owl:Class ;
    rdfs:label "refusal of amends"@en ;
    rdfs:comment "Refusal is itself a way of answering, and so realizes answerability: only an answerable agent can refuse."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001008 ],
        nao:0001011 ;
    skos:definition "An accountability response in which an agent that is called to account for a breach declines to make amends for it."@en .

nao:0001015 a owl:Class ;
    rdfs:label "sanction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001008 ],
        nao:0001011 ;
    skos:definition "An accountability response in which some agent imposes a setback on another agent because of that agent's breach."@en .

nao:0001016 a owl:Class ;
    rdfs:label "narrative revision"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000057 ;
            owl:someValuesFrom nao:0001007 ],
        nao:0001011 ;
    skos:altLabel "rebranding"@en,
        "spin"@en ;
    skos:definition "An accountability response in which accountability records or public representations of a breach are changed, without any change in what the breach was."@en .

nao:0001017 a owl:Class ;
    rdfs:label "retraining"@en ;
    rdfs:subClassOf nao:0001011 ;
    skos:definition "An accountability response in which the dispositions of an agent or artifact are changed so that breaches of the same kind become less likely."@en .

nao:0001018 a owl:Class ;
    rdfs:label "reset"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom nao:0001004 ],
        nao:0001011 ;
    skos:definition "An accountability response that realizes the resettability of some entity."@en ;
    skos:example "a factory reset; a rollback to an earlier checkpoint; a relaunch as a new version"@en .

nao:0001020 a owl:Class ;
    rdfs:label "irreversibly accountable agent"@en ;
    rdfs:comment "Defined class: the reasoner classifies an entity here only when every condition is recorded. Under the open-world assumption it cannot conclude that a condition fails; the SHACL shapes in src/shapes report failing conditions by name."@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001002 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001003 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001005 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001006 ] [ a owl:Restriction ;
                        owl:onProperty nao:0001101 ;
                        owl:someValuesFrom nao:0001009 ] ) ] ;
    skos:definition "A material entity that has normative standing, is the agent of some normative breach, bears the moral residue of some breach, and has the capacity to repair and the capacity to have done otherwise: an entity satisfying all five conditions of the Irreversible Accountability Test."@en .

nao:0001021 a owl:Class ;
    rdfs:label "displaced answerability"@en ;
    rdfs:comment "The answerability a vendor, developer, or deployer has for its artifact's breach: 'meanwhile, around it' in the Reset Button demonstration."@en ;
    rdfs:subClassOf nao:0001008 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( nao:0001008 [ a owl:Restriction ;
                        owl:onProperty nao:0001102 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( nao:0001009 [ a owl:Restriction ;
                                            owl:onProperty nao:0001100 ;
                                            owl:someValuesFrom nao:0001019 ] ) ] ] ) ] ;
    skos:definition "Answerability for a normative breach that is attributed to some resettable artifact."@en .

nao:0001106 a owl:ObjectProperty ;
    rdfs:label "wrongs"@en ;
    rdfs:domain nao:0001009 ;
    rdfs:range obo:BFO_0000004 ;
    skos:definition "A relation between a normative breach and an independent continuant whose interests the norm protects and the breach sets back."@en .

nao:0001111 a owl:ObjectProperty ;
    rdfs:label "codified as"@en ;
    rdfs:comment "Connects moral answerability to legal accountability: a physician's answerability for a missed diagnosis is codified as the patient's claim in malpractice. Not every answerability is codified, and not every legal position codifies an answerability."@en ;
    rdfs:domain nao:0001008 ;
    rdfs:range lof:ODP003_0001000 ;
    skos:definition "A relation between an answerability and a legal position, in the sense of LOF-ODP-003, through which a legal system gives effect to it."@en .

<https://sool.davidkoepsell.com/nao/nao-full.owl> a owl:Ontology ;
    rdfs:comment "Test fixture: NAO's native axioms and the BFO 2020 / LOF ODP003 terms they use, rebuilt from the o2u-source block of an owl2uml diagram of nao-full.owl. Not the full ontology: imported terms NAO does not use are absent." .

obo:BFO_0000023 a owl:Class .

obo:BFO_0000062 a owl:ObjectProperty ;
    rdfs:label "preceded by"@en .

obo:BFO_0000117 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has occurrent part"@en ;
    dc:identifier "202-BFO" ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    owl:inverseOf obo:BFO_0000132 ;
    skos:definition "b has occurrent part c =Def c occurrent part of b"@en ;
    skos:example "Mary's life has occurrent part Mary's 5th birthday"@en .

obo:BFO_0000139 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "temporal part of"@en ;
    dc:identifier "078-BFO" ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    rdfs:subPropertyOf obo:BFO_0000132 ;
    skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en ;
    skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en .

obo:BFO_0000141 a owl:Class .

obo:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    dc:identifier "057-BFO" ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
    skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .

obo:BFO_0000194 a owl:ObjectProperty ;
    rdfs:label "specifically depended on by"@en .

nao:0001001 a owl:Class ;
    rdfs:label "accountability capacity"@en ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "A disposition of an agent to be called to account for its conduct, grounded in the agent's persisting as the same entity through time."@en .

nao:0001003 a owl:Class ;
    rdfs:label "control capacity"@en ;
    rdfs:comment "The counterfactual-control condition of the Irreversible Accountability Test."@en ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "A disposition of an agent such that, in the circumstances of some conduct, it could have conducted itself otherwise."@en .

nao:0001005 a owl:Class ;
    rdfs:label "normative standing"@en ;
    rdfs:comment "Standing is what responses raise or lower; the Reset Button demonstration shows it on a 0 to 100 scale. Whether standing is better modeled as a relational quality (standing with some community) is an open question."@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A quality of an agent in virtue of which others are warranted in relying on its conformity to the norms that apply to it."@en .

nao:0001019 a owl:Class ;
    rdfs:label "resettable artifact"@en ;
    rdfs:comment "A deployed software system is treated as a material entity: the hardware and stored patterns on which it runs, as LOF-ODP-001 treats digital documents. What makes an artifact resettable is a disposition, not a substrate: an artificial agent with one permanent identity and no reset is not a resettable artifact."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty obo:BFO_0000196 ;
                    owl:someValuesFrom nao:0001008 ] ],
        [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty obo:BFO_0000196 ;
                    owl:someValuesFrom nao:0001006 ] ],
        obo:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000040 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000196 ;
                        owl:someValuesFrom nao:0001004 ] ) ] ;
    skos:definition "A material entity that is the bearer of some resettability."@en .

nao:0001104 a owl:ObjectProperty ;
    rdfs:label "responds to"@en ;
    rdfs:domain nao:0001011 ;
    rdfs:range nao:0001009 ;
    skos:definition "A relation between an accountability response and the normative breach it is directed at."@en .

nao:0001105 a owl:ObjectProperty ;
    rdfs:label "violates"@en ;
    rdfs:domain nao:0001009 ;
    rdfs:range nao:0001022 ;
    skos:definition "A relation between a normative breach and a norm that the conduct in the breach fails to conform to."@en .

nao:0001107 a owl:ObjectProperty ;
    rdfs:label "repeat of"@en ;
    rdfs:domain nao:0001009 ;
    rdfs:range nao:0001009 ;
    rdfs:subPropertyOf obo:BFO_0000062 ;
    skos:definition "A relation between a normative breach and an earlier breach of the same kind attributed to the same agent."@en .

nao:0001110 a owl:ObjectProperty ;
    rdfs:label "records"@en ;
    rdfs:domain nao:0001007 ;
    rdfs:range obo:BFO_0000015 ;
    skos:definition "A relation between an accountability record and a normative breach or response that it is about."@en .

lof:ODP003_0001100 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "held by"@en ;
    rdfs:comment "In Option A this is a functional subproperty of BFO 'inheres in', reflecting BFO's axiom that a specifically dependent continuant has exactly one bearer. A position can therefore never have two holders, even at different times."@en ;
    rdfs:domain lof:ODP003_0001000 ;
    rdfs:range obo:BFO_0000040 ;
    rdfs:subPropertyOf obo:BFO_0000197 ;
    skos:definition "A relation between a legal position and the person or organization whose position it is."@en .

lof:ODP003_0001101 a owl:ObjectProperty ;
    rdfs:label "grounded in"@en ;
    rdfs:domain lof:ODP003_0001000 ;
    rdfs:range lof:ODP001_0001001 ;
    skos:definition "A relation between a legal position and the legal content in virtue of which it exists, such as the contract term creating a duty to pay."@en .

lof:ODP003_0001102 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "correlative of"@en ;
    rdfs:domain lof:ODP003_0001000 ;
    rdfs:range lof:ODP003_0001000 ;
    skos:definition "A symmetric relation between two legal positions held by different parties, each of which exists if and only if the other does, such as a claim and the duty owed in satisfaction of it."@en .

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    dc:identifier "001-BFO" ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en ;
    skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en .

obo:BFO_0000006 a owl:Class .

obo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    dc:identifier "058-BFO" ;
    rdfs:subClassOf obo:BFO_0000020 ;
    owl:disjointWith obo:BFO_0000019 ;
    skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en ;
    skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .

obo:BFO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    dc:identifier "248-BFO" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000020 obo:BFO_0000031 [ a owl:Class ;
                        owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                                    owl:complementOf obo:BFO_0000006 ] ) ] ) ] ;
    skos:definition "p has participant c =Def c participates in p"@en ;
    skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en .

obo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en ;
    dc:identifier "271-BFO" ;
    rdfs:domain obo:BFO_0000002 ;
    rdfs:range obo:BFO_0000002 ;
    skos:definition "b has continuant part c =Def c continuant part of b"@en ;
    skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en .

obo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en .

nao:0001002 a owl:Class ;
    rdfs:label "repair capacity"@en ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "A disposition of an agent to make good, from its own resources or conduct, a setback that its conduct caused."@en .

nao:0001004 a owl:Class ;
    rdfs:label "resettability"@en ;
    rdfs:subClassOf obo:BFO_0000016 ;
    skos:definition "A disposition of an entity to undergo a process after which it, or a successor that takes its place, has no state that carries the consequences of its earlier conduct."@en ;
    skos:example "a model's capacity to be rolled back to a checkpoint; a device's factory reset; a product's replacement by a new version"@en .

nao:0001006 a owl:Class ;
    rdfs:label "moral residue"@en ;
    rdfs:comment "BFO placement: residue is specifically dependent, so it cannot be copied, transferred, or deleted while its bearers exist; it is relational because it connects wrongdoer and wronged. Contrast accountability record, a generically dependent continuant that can be edited or erased. Responses change the agent's standing; they do not remove residue."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty nao:0001103 ;
            owl:someValuesFrom nao:0001009 ],
        obo:BFO_0000145 ;
    skos:definition "A relational quality that inheres in the agent of a normative breach and in those it wrongs, that comes into existence through the breach, and that persists for as long as its bearers do, whatever responses follow."@en .

nao:0001007 a owl:Class ;
    rdfs:label "accountability record"@en ;
    rdfs:comment "Records, unlike residue, can be edited, rewritten, or erased; narrative revision and reset act on records."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty nao:0001110 ;
            owl:someValuesFrom nao:0001009 ],
        obo:BFO_0000031 ;
    skos:definition "A generically dependent continuant that is about some normative breach and the responses to it, and that is concretized in some log, file, register, or memory."@en .

nao:0001022 a owl:Class ;
    rdfs:label "norm"@en ;
    rdfs:comment "BFO placement: a norm, like legal content, can be concretized in many minds, texts, and practices and survives the loss of any one of them. Legal norms are legal content in the sense of LOF-ODP-001; moral, professional, and institutional norms are norms that need not be."@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    skos:closeMatch lof:ODP001_0001001 ;
    skos:definition "A generically dependent continuant that prescribes, permits, or prohibits some kind of conduct for some kind of agent."@en .

nao:0001100 a owl:ObjectProperty ;
    rdfs:label "attributed to"@en ;
    rdfs:comment "Attribution is a relation of agency, not of blame: a resettable artifact can be the entity whose conduct a breach is, even if it cannot answer for it."@en ;
    rdfs:domain nao:0001009 ;
    rdfs:range obo:BFO_0000004 ;
    rdfs:subPropertyOf obo:BFO_0000057 ;
    owl:inverseOf nao:0001101 ;
    skos:definition "A relation between a normative breach and an independent continuant whose conduct the breach is."@en .

nao:0001101 a owl:ObjectProperty ;
    rdfs:label "agent of"@en ;
    skos:definition "A relation between an independent continuant and a normative breach that is its conduct."@en .

nao:0001102 a owl:ObjectProperty ;
    rdfs:label "answers for"@en ;
    rdfs:domain nao:0001008 ;
    rdfs:range nao:0001009 ;
    rdfs:subPropertyOf nao:0001103 ;
    skos:definition "A relation between an answerability and the normative breach it is answerability for."@en .

nao:0001103 a owl:ObjectProperty ;
    rdfs:label "occasioned by"@en ;
    rdfs:domain obo:BFO_0000020 ;
    rdfs:range nao:0001009 ;
    skos:definition "A relation between a specifically dependent continuant and a normative breach through which it came into existence."@en .

obo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    dc:identifier "055-BFO" ;
    rdfs:subClassOf obo:BFO_0000020 ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
    skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .

obo:BFO_0000132 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "occurrent part of"@en ;
    dc:identifier "003-BFO" ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en ;
    skos:example "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en .

obo:BFO_0000176 a owl:ObjectProperty ;
    rdfs:label "continuant part of"@en ;
    dc:identifier "221-BFO" ;
    rdfs:domain obo:BFO_0000002 ;
    rdfs:range obo:BFO_0000002 ;
    owl:inverseOf obo:BFO_0000178 ;
    skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b part of c at t"@en ;
    skos:example "Milk teeth continuant part of human; surgically removed tumour continuant part of organism"@en ;
    skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en .

lof:ODP001_0001001 a owl:Class .

obo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    dc:identifier "062-BFO" ;
    rdfs:subClassOf obo:BFO_0000017 ;
    owl:disjointWith obo:BFO_0000023 ;
    skos:altLabel "internally-grounded realizable entity"@en ;
    skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en ;
    skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    dc:identifier "074-BFO" ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:altLabel "g-dependent continuant"@en ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en ;
    skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en .

obo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    dc:identifier "059-BFO" ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000017 ;
    skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en ;
    skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en .

lof:ODP003_0001000 a owl:Class ;
    rdfs:label "legal position"@en ;
    rdfs:comment "BFO placement, OPTION A (LOF-P-004): a legal position is a specifically dependent continuant inhering in its holder, as a role or disposition does. It exists only as long as its holder exists and cannot migrate from one holder to another, so assignment of a claim is modeled as the termination of one position and the creation of a new one in the assignee. OPEN QUESTION for the founding coordinators; see Option B."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty lof:ODP003_0001101 ;
            owl:someValuesFrom lof:ODP001_0001001 ],
        [ a owl:Restriction ;
            owl:onProperty lof:ODP003_0001102 ;
            owl:someValuesFrom lof:ODP003_0001000 ],
        [ a owl:Restriction ;
            owl:onProperty lof:ODP003_0001100 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        obo:BFO_0000020 ;
    skos:altLabel "Hohfeldian position"@en ;
    skos:definition "A continuant that is held by a person or organization in virtue of some legal content, and that consists in what the holder is legally required, permitted, or enabled to do, or protected from having done to them, in relation to some other party."@en .

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    dc:identifier "008-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000002 ;
            owl:onProperty obo:BFO_0000176 ],
        obo:BFO_0000001 ;
    owl:disjointWith obo:BFO_0000003 ;
    skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en ;
    skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en .

obo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    dc:identifier "077-BFO" ;
    rdfs:subClassOf obo:BFO_0000001 ;
    skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en ;
    skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en .

obo:BFO_0000196 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    dc:identifier "053-BFO" ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000004 [ a owl:Class ;
                        owl:complementOf obo:BFO_0000006 ] ) ] ;
    rdfs:range obo:BFO_0000020 ;
    rdfs:subPropertyOf obo:BFO_0000194 ;
    owl:inverseOf obo:BFO_0000197 ;
    skos:definition "b bearer of c =Def c inheres in b"@en ;
    skos:example "A patch of ink is the bearer of a colour quality; an organism is the bearer of a temperature quality"@en .

nao:0001011 a owl:Class ;
    rdfs:label "accountability response"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty nao:0001104 ;
            owl:someValuesFrom nao:0001009 ],
        obo:BFO_0000015 ;
    skos:definition "A process that is directed at some normative breach and in which some entity answers for it, or in which it is dealt with on someone's behalf."@en .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    dc:identifier "017-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000004 ;
            owl:onProperty obo:BFO_0000176 ],
        obo:BFO_0000002 ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en ;
    skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en .

obo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    dc:identifier "083-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000132 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000117 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000139 ],
        obo:BFO_0000003 ;
    skos:altLabel "event"@en ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
    skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    dc:identifier "050-BFO" ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en ;
    skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en,
        "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en .

nao:0001008 a owl:Class ;
    rdfs:label "answerability"@en ;
    rdfs:comment "Realized in accountability responses. An agent can be answerable for a breach that is not its own conduct, as a deployer is for its artifact's breach; see displaced answerability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty nao:0001102 ;
            owl:someValuesFrom nao:0001009 ],
        obo:BFO_0000016 ;
    skos:definition "A disposition of an agent, occasioned by some normative breach, to be called to account for that breach and to respond to it."@en .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    dc:identifier "019-BFO" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000029 obo:BFO_0000040 obo:BFO_0000140 ) ] ;
            owl:onProperty obo:BFO_0000178 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000040 ;
            owl:onProperty obo:BFO_0000176 ],
        obo:BFO_0000004 ;
    owl:disjointWith obo:BFO_0000141 ;
    skos:definition "(Elucidation) A material entity is an independent continuant that at all times at which it exists has some portion of matter as continuant part"@en ;
    skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en .

nao:0001009 a owl:Class ;
    rdfs:label "normative breach"@en ;
    rdfs:comment "BFO placement: a breach unfolds in time and has temporal parts. Breach by omission is treated as a process in the sense of the agent's conduct during the period in which the prescribed conduct did not occur; see LOF-ODP-004 'undischarged during' for the corresponding legal treatment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty nao:0001105 ;
            owl:someValuesFrom nao:0001022 ],
        [ a owl:Restriction ;
            owl:onProperty nao:0001100 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        obo:BFO_0000015 ;
    skos:definition "A process in which some agent engages in conduct that some norm prohibits, or fails to engage in conduct that some norm prescribes."@en ;
    skos:example "a physician's missed diagnosis; a vehicle running a red light; a probe mining in violation of a treaty"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000004 obo:BFO_0000020 obo:BFO_0000031 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000004 obo:BFO_0000020 obo:BFO_0000031 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000004 obo:BFO_0000020 obo:BFO_0000031 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:BFO_0000008 obo:BFO_0000011 obo:BFO_0000015 obo:BFO_0000035 ) .

